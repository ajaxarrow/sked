{
  "name": "sked",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "db:seed": "npx tsx scripts/seed.ts",
    "db:reset": "node -e \"['sked.db','sked.db-shm','sked.db-wal'].forEach(f=>require('fs').rmSync(f,{force:true}))\" && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@nuxt/ui": "^2.21.0",
    "better-sqlite3": "^11.5.0",
    "drizzle-orm": "^0.38.4",
    "nuxt": "^3.14.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
